// DMS Window Rules - Managed by Dux Modular Shell
// Do not edit manually - changes may be overwritten

// @id=dms-floating-windows @name=DMS Floating Windows
window-rule {
    match app-id="^(dev\\.duxlabs\\.shell|com\\.danklinux\\.dms)$"
    open-floating true
}

// @id=wr_1790823714164754143 @name=notes-window
window-rule {
    match app-id="^notes-window$"
    opacity 0.95
    open-floating true
    open-focused true
    default-column-width { fixed 700; }
    default-window-height { fixed 1660; }
    geometry-corner-radius 12
    default-floating-position x=30 y=30
}

// @id=dms-window-opaque @name=DMS Window Opaque
window-rule {
    match app-id="^(dev\\.duxlabs\\.shell|com\\.danklinux\\.dms)$"
    opacity 1.00
}
